generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  legalName       String?
  rfc             String?
  taxRegime       String?
  postalCode      String?
  fiscalAddress   String?
  phone           String?
  email           String?
  defaultCreditDays Int?
  inventoryEnabled Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  users            User[]
  clients          Client[]
  prospects        Prospect[]
  suppliers        Supplier[]
  integrations     IntegrationSetting[]
  equipmentTypes   EquipmentType[]
  equipmentBrands  EquipmentBrand[]
  originated       Equipment[]          @relation("EquipmentOrigin")
  priorities       Priority[]
  attentionsOrigin Attention[]          @relation("AttentionOrigin")
  attentionsService Attention[]         @relation("AttentionService")
  technicalCases   TechnicalCase[]
  custodyMovements CustodyMovement[]
  parts            Part[]
  stockMovements   StockMovement[]
  quotes           Quote[]
  sales            Sale[]
  agendaCategories AgendaCategory[]
  agendaActivities AgendaActivity[]
  goalTypes        GoalType[]
  salesGoals       SalesGoal[]
  billingDocuments BillingDocument[]
  receivables      Receivable[]
  payables         Payable[]
  payments         Payment[]
  financeAccounts  FinanceAccount[]
  financeMovements FinanceMovement[]
  purchases        Purchase[]
}

model User {
  id                     String   @id @default(cuid())
  username               String   @unique
  name                   String
  passwordHash           String
  role                   String
  companyId              String?
  company                Company? @relation(fields: [companyId], references: [id])
  active                 Boolean  @default(true)
  discountLimitPct       Float?
  monthlyPurchaseBudget  Float?
  purchaseLimit          Float?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  version                Int      @default(1)

  sessions       Session[]
  impersonations Session[] @relation("SessionImpersonation")
  history        FunctionalHistory[]
  technicalCases TechnicalCase[]
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash          String   @unique
  activeCompanyId    String?
  impersonatedUserId String?
  impersonatedUser   User?    @relation("SessionImpersonation", fields: [impersonatedUserId], references: [id])
  createdAt          DateTime @default(now())
  expiresAt       DateTime
  lastSeenAt      DateTime @default(now())
}

model Client {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  name             String
  classification   String?
  ownerUserId      String?
  requiresInvoice  Boolean?
  creditDays       Int?
  rfc              String?
  taxRegime        String?
  fiscalZip        String?
  fiscalAddress    String?
  deliveryAddress  String?
  active           Boolean  @default(true)
  isSystem         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  version          Int      @default(1)

  contacts   Contact[]
  prospects  Prospect[]
  equipments Equipment[]
  attentions Attention[]
  quotes     Quote[]
  sales      Sale[]
  billingDocuments BillingDocument[]
  receivables      Receivable[]
  payments         Payment[]

  @@index([companyId, name])
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  roleTitle String?
  email     String?
  isPrimary Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prospect {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  ownerUserId String?
  source      String?
  note        String?
  status      String   @default("NUEVO")
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  activities ProspectActivity[]

  @@index([companyId, status])
}

model ProspectActivity {
  id           String    @id @default(cuid())
  prospectId   String
  prospect     Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  note         String
  nextFollowUp DateTime?
  authorUserId String
  createdAt    DateTime  @default(now())
}

model Supplier {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  contactName   String?
  phone         String?
  email         String?
  rfc           String?
  fiscalAddress String?
  creditDays    Int?
  issuesInvoice Boolean?
  category      String?
  active        Boolean  @default(true)
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  version       Int      @default(1)

  payables Payable[]
  purchases Purchase[]

  @@index([companyId, name])
}

/// companyId "GLOBAL" is the shared MOT sequence. Every other series is per company.
model FolioSequence {
  id         String @id @default(cuid())
  companyId  String
  series     String
  nextNumber Int    @default(1)

  @@unique([companyId, series])
}

model IntegrationSetting {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  provider   String
  secretEnc  String?
  secretHint String?
  updatedAt  DateTime @updatedAt

  @@unique([companyId, provider])
}

model EquipmentType {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, name])
}

model EquipmentBrand {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, name])
}

model CatalogType {
  id     String         @id @default(cuid())
  name   String
  key    String         @unique
  models CatalogModel[]
}

model CatalogBrand {
  id     String         @id @default(cuid())
  name   String
  key    String         @unique
  models CatalogModel[]
}

model CatalogModel {
  id      String       @id @default(cuid())
  typeId  String
  type    CatalogType  @relation(fields: [typeId], references: [id])
  brandId String
  brand   CatalogBrand @relation(fields: [brandId], references: [id])
  name    String
  key     String

  @@unique([typeId, brandId, key])
}

/// EQUI belongs to one company. MOT is a global physical identity with originCompanyId.
model Equipment {
  id              String   @id @default(cuid())
  kind            String
  folio           String   @unique
  originCompanyId String
  originCompany   Company  @relation("EquipmentOrigin", fields: [originCompanyId], references: [id])
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  typeName        String?
  brandName       String?
  model           String
  description     String?
  serial          String?
  custody         String
  holderCompanyId String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  attentions     Attention[]
  movements      CustodyMovement[]
  technicalCases TechnicalCase[]
  quotes         Quote[]

  @@index([originCompanyId, kind])
  @@index([custody])
}

model Priority {
  id              String  @id @default(cuid())
  companyId       String
  company         Company @relation(fields: [companyId], references: [id])
  attentionType   String
  name            String
  price           Float?
  incrementPct    Float?
  targetMinDays   Int?
  targetMaxDays   Int?
  slaMaxDays      Int
  sortOrder       Int     @default(0)
  active          Boolean @default(true)

  @@unique([companyId, attentionType, name])
}

/// Service episode over a physical identity. Diagnosis execution belongs to a later phase.
model Attention {
  id                  String    @id @default(cuid())
  equipmentId         String
  equipment           Equipment @relation(fields: [equipmentId], references: [id])
  originCompanyId     String
  originCompany       Company   @relation("AttentionOrigin", fields: [originCompanyId], references: [id])
  serviceCompanyId    String
  serviceCompany      Company   @relation("AttentionService", fields: [serviceCompanyId], references: [id])
  adminClientId       String
  adminClient         Client    @relation(fields: [adminClientId], references: [id])
  attentionType       String
  priorityName        String
  priorityPrice       Float?
  priorityIncrementPct Float?
  priorityTargetMin   Int?
  priorityTargetMax   Int?
  prioritySlaMaxDays  Int
  reportedFault       String
  antecedent          String?
  deliveryInstructions String?
  sellerUserId        String?
  originalCaseId      String?
  originQuoteId       String?
  status              String    @default("ABIERTA")
  slaStartedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  version             Int       @default(1)

  movements      CustodyMovement[]
  technicalCases TechnicalCase[]

  @@index([equipmentId])
  @@index([serviceCompanyId, status])
}

model TechnicalCase {
  id                  String    @id @default(cuid())
  folio               String
  attentionId         String
  attention           Attention @relation(fields: [attentionId], references: [id])
  equipmentId         String
  equipment           Equipment @relation(fields: [equipmentId], references: [id])
  serviceCompanyId    String
  serviceCompany      Company   @relation(fields: [serviceCompanyId], references: [id])
  kind                String
  status              String
  assigneeUserId      String?
  assignee            User?     @relation(fields: [assigneeUserId], references: [id])
  externalSupplierId  String?
  externalDocument    String?
  resultText          String?
  warrantyDecision    String?
  commercialDecision  String?
  commercialReason    String?
  originalCaseId      String?
  spawnedFromId       String?
  paidAt              DateTime?
  quotePending        Boolean   @default(false)
  returnReason        String?
  slaDueAt            DateTime?
  finishedByUserId    String?
  validatedByUserId   String?
  validatedAt         DateTime?
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  logs     TechnicalLog[]
  requests PartRequest[]

  @@unique([serviceCompanyId, folio])
  @@index([serviceCompanyId, status])
  @@index([equipmentId])
  @@index([attentionId])
}

model TechnicalLog {
  id           String        @id @default(cuid())
  caseId       String
  case         TechnicalCase @relation(fields: [caseId], references: [id])
  body         String
  authorUserId String
  createdAt    DateTime      @default(now())

  @@index([caseId, createdAt])
}

model PartRequest {
  id           String        @id @default(cuid())
  caseId       String
  case         TechnicalCase @relation(fields: [caseId], references: [id])
  companyId    String
  partNumber   String
  description  String
  link         String?
  qtyRequested Int
  qtyReceived  Int           @default(0)
  qtyIssued    Int           @default(0)
  status       String        @default("SOLICITADA")
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([caseId])
}

model CustodyMovement {
  id               String    @id @default(cuid())
  equipmentId      String
  equipment        Equipment @relation(fields: [equipmentId], references: [id])
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  attentionId      String?
  attention        Attention? @relation(fields: [attentionId], references: [id])
  kind             String
  reason           String
  receiverName     String?
  deliveryMode     String?
  contact          String?
  enablingDocument String?
  supplierId       String?
  notes            String?
  authorUserId     String
  occurredAt       DateTime  @default(now())
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime  @default(now())

  @@index([equipmentId, createdAt])
  @@index([companyId, kind])
}

model Part {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  partNumber  String
  description String
  qty         Int      @default(0)
  minQty      Int?
  maxQty      Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  movements StockMovement[]

  @@unique([companyId, partNumber])
}

model StockMovement {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  partId       String
  part         Part     @relation(fields: [partId], references: [id])
  kind         String
  quantity     Int
  qtyAfter     Int
  note         String?
  authorUserId String
  createdAt    DateTime @default(now())

  @@index([partId, createdAt])
}

model Quote {
  id                 String   @id @default(cuid())
  folio              String
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id])
  quoteType          String
  status             String
  equipmentId        String?
  equipment          Equipment? @relation(fields: [equipmentId], references: [id])
  technicalCaseId    String?
  linkedQuoteId      String?
  preliminaryType    String?
  preliminaryBrand   String?
  preliminaryModel   String?
  preliminarySerial  String?
  reference          String?
  creditDays         Int?
  discountPct        Float    @default(0)
  sellerUserId       String?
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lines QuoteLine[]
  sales Sale[]
  billingDocuments BillingDocument[]

  @@unique([companyId, folio])
  @@index([companyId, status])
  @@index([technicalCaseId])
}

model QuoteLine {
  id           String  @id @default(cuid())
  quoteId      String
  quote        Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  concept      String
  quantity     Int     @default(1)
  unitPrice    Float?
  basePrice    Float?
  incrementPct Float?
  authorized   Boolean @default(false)
}

model Sale {
  id        String   @id @default(cuid())
  folio     String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id])
  createdAt DateTime @default(now())

  lines SaleLine[]

  @@unique([companyId, folio])
}

model SaleLine {
  id           String @id @default(cuid())
  saleId       String
  sale         Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  concept      String
  qtySold      Int
  qtyReceived  Int    @default(0)
  qtyDelivered Int    @default(0)
}

model AgendaCategory {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  name           String
  countsForGoals Boolean  @default(false)
  active         Boolean  @default(true)

  activities AgendaActivity[]

  @@unique([companyId, name])
}

model AgendaActivity {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  authorUserId String
  categoryId   String?
  category     AgendaCategory? @relation(fields: [categoryId], references: [id])
  clientId     String?
  prospectId   String?
  note         String
  scheduledAt  DateTime
  evidence     String?
  createdAt    DateTime        @default(now())

  @@index([companyId, scheduledAt])
}

model GoalType {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  active    Boolean @default(true)

  goals SalesGoal[]

  @@unique([companyId, name])
}

model SalesGoal {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String
  goalTypeId String
  goalType   GoalType @relation(fields: [goalTypeId], references: [id])
  year       Int
  month      Int
  target     Int

  @@unique([companyId, userId, goalTypeId, year, month])
}

model BillingDocument {
  id                String    @id @default(cuid())
  folio             String
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  kind              String
  status            String
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id])
  quoteId           String?
  quote             Quote?    @relation(fields: [quoteId], references: [id])
  technicalCaseId   String?
  saleId            String?
  equipmentId       String?
  concept           String
  subtotal          Float
  iva               Float
  total             Float
  creditDays        Int       @default(0)
  rfcSnapshot       String?
  issuedAt          DateTime?
  dueAt             DateTime?
  fiscalStatus      String    @default("NO_APLICA")
  fiscalError       String?
  requestedByUserId String?
  issuedByUserId    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  version           Int       @default(1)

  receivable Receivable?
  payable    Payable?
  lines      BillingLine[]

  @@unique([companyId, folio])
  @@index([companyId, status])
}

model BillingLine {
  id         String          @id @default(cuid())
  documentId String
  document   BillingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  concept    String
  quantity   Int
  unitPrice  Float
  amount     Float
}

model Receivable {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  documentId   String          @unique
  document     BillingDocument @relation(fields: [documentId], references: [id])
  clientId     String
  client       Client          @relation(fields: [clientId], references: [id])
  sellerUserId String?
  amount       Float
  balance      Float
  dueAt        DateTime
  status       String
  createdAt    DateTime        @default(now())

  applications PaymentApplication[]
  notes        CollectionNote[]

  @@index([companyId, status])
}

model Payable {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  supplierId       String
  supplier         Supplier        @relation(fields: [supplierId], references: [id])
  documentId       String?         @unique
  document         BillingDocument? @relation(fields: [documentId], references: [id])
  purchaseId       String?         @unique
  equipmentId      String?
  amount           Float
  balance          Float
  dueAt            DateTime
  status           String
  createdAt        DateTime        @default(now())

  applications PaymentApplication[]

  @@index([companyId, status])
}

model Payment {
  id           String   @id @default(cuid())
  folio        String
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  amount       Float
  method       String
  receipt      String
  destination  String
  status       String
  kind         String
  authorUserId String
  createdAt    DateTime @default(now())

  applications PaymentApplication[]

  @@unique([companyId, folio])
  @@index([companyId, status])
}

model PaymentApplication {
  id           String      @id @default(cuid())
  paymentId    String
  payment      Payment     @relation(fields: [paymentId], references: [id])
  receivableId String?
  receivable   Receivable? @relation(fields: [receivableId], references: [id])
  payableId    String?
  payable      Payable?    @relation(fields: [payableId], references: [id])
  amount       Float
  confirmedAt  DateTime?
}

model CollectionNote {
  id            String     @id @default(cuid())
  receivableId  String
  receivable    Receivable @relation(fields: [receivableId], references: [id])
  note          String
  promiseAmount Float?
  followUpAt    DateTime?
  authorUserId  String
  createdAt     DateTime   @default(now())
}

model FinanceAccount {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  kind      String
  balance   Float    @default(0)
  active    Boolean  @default(true)

  movements FinanceMovement[]

  @@unique([companyId, name])
}

model FinanceMovement {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  accountId     String
  account       FinanceAccount @relation(fields: [accountId], references: [id])
  direction     String
  amount        Float
  category      String
  originType    String?
  originId      String?
  note          String?
  pendingProof  Boolean        @default(false)
  proofNote     String?
  createdAt     DateTime       @default(now())

  @@index([companyId, createdAt])
}

model Purchase {
  id               String    @id @default(cuid())
  folio            String
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  kind             String
  status           String
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  concept          String
  quantity         Int       @default(1)
  amount           Float
  authorizedAmount Float?
  destination      String
  destinationRef   String?
  settlement       String?
  requesterUserId  String
  accountId        String?
  payableId        String?
  movementId       String?
  cancelReason     String?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([companyId, folio])
  @@index([companyId, status])
}

model FunctionalHistory {
  id           String   @id @default(cuid())
  companyId    String?
  entityType   String
  entityId     String
  action       String
  summary      String
  authorUserId String?
  author       User?    @relation(fields: [authorUserId], references: [id])
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

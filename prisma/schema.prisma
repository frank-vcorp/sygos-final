generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  legalName       String?
  rfc             String?
  taxRegime       String?
  postalCode      String?
  fiscalAddress   String?
  phone           String?
  email           String?
  defaultCreditDays Int?
  inventoryEnabled Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  users        User[]
  clients      Client[]
  prospects    Prospect[]
  suppliers    Supplier[]
  integrations IntegrationSetting[]
}

model User {
  id                     String   @id @default(cuid())
  username               String   @unique
  name                   String
  passwordHash           String
  role                   String
  companyId              String?
  company                Company? @relation(fields: [companyId], references: [id])
  active                 Boolean  @default(true)
  discountLimitPct       Float?
  monthlyPurchaseBudget  Float?
  purchaseLimit          Float?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  version                Int      @default(1)

  sessions Session[]
  history  FunctionalHistory[]
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String   @unique
  activeCompanyId String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  lastSeenAt      DateTime @default(now())
}

model Client {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  name             String
  classification   String?
  ownerUserId      String?
  requiresInvoice  Boolean?
  creditDays       Int?
  rfc              String?
  taxRegime        String?
  fiscalZip        String?
  fiscalAddress    String?
  deliveryAddress  String?
  active           Boolean  @default(true)
  isSystem         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  version          Int      @default(1)

  contacts Contact[]
  prospects Prospect[]

  @@index([companyId, name])
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  roleTitle String?
  email     String?
  isPrimary Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prospect {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  ownerUserId String?
  source      String?
  note        String?
  status      String   @default("NUEVO")
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  activities ProspectActivity[]

  @@index([companyId, status])
}

model ProspectActivity {
  id           String    @id @default(cuid())
  prospectId   String
  prospect     Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  note         String
  nextFollowUp DateTime?
  authorUserId String
  createdAt    DateTime  @default(now())
}

model Supplier {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  contactName   String?
  phone         String?
  email         String?
  rfc           String?
  fiscalAddress String?
  creditDays    Int?
  issuesInvoice Boolean?
  category      String?
  active        Boolean  @default(true)
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  version       Int      @default(1)

  @@index([companyId, name])
}

/// companyId "GLOBAL" is the shared MOT sequence. Every other series is per company.
model FolioSequence {
  id         String @id @default(cuid())
  companyId  String
  series     String
  nextNumber Int    @default(1)

  @@unique([companyId, series])
}

model IntegrationSetting {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  provider   String
  secretEnc  String?
  secretHint String?
  updatedAt  DateTime @updatedAt

  @@unique([companyId, provider])
}

model FunctionalHistory {
  id           String   @id @default(cuid())
  companyId    String?
  entityType   String
  entityId     String
  action       String
  summary      String
  authorUserId String?
  author       User?    @relation(fields: [authorUserId], references: [id])
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

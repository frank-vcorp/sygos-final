generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  legalName       String?
  rfc             String?
  taxRegime       String?
  postalCode      String?
  fiscalAddress   String?
  phone           String?
  email           String?
  defaultCreditDays Int?
  inventoryEnabled Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  users            User[]
  clients          Client[]
  prospects        Prospect[]
  suppliers        Supplier[]
  integrations     IntegrationSetting[]
  equipmentTypes   EquipmentType[]
  equipmentBrands  EquipmentBrand[]
  originated       Equipment[]          @relation("EquipmentOrigin")
  priorities       Priority[]
  attentionsOrigin Attention[]          @relation("AttentionOrigin")
  attentionsService Attention[]         @relation("AttentionService")
  technicalCases   TechnicalCase[]
  custodyMovements CustodyMovement[]
  parts            Part[]
  stockMovements   StockMovement[]
}

model User {
  id                     String   @id @default(cuid())
  username               String   @unique
  name                   String
  passwordHash           String
  role                   String
  companyId              String?
  company                Company? @relation(fields: [companyId], references: [id])
  active                 Boolean  @default(true)
  discountLimitPct       Float?
  monthlyPurchaseBudget  Float?
  purchaseLimit          Float?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  version                Int      @default(1)

  sessions       Session[]
  history        FunctionalHistory[]
  technicalCases TechnicalCase[]
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String   @unique
  activeCompanyId String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  lastSeenAt      DateTime @default(now())
}

model Client {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  name             String
  classification   String?
  ownerUserId      String?
  requiresInvoice  Boolean?
  creditDays       Int?
  rfc              String?
  taxRegime        String?
  fiscalZip        String?
  fiscalAddress    String?
  deliveryAddress  String?
  active           Boolean  @default(true)
  isSystem         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  version          Int      @default(1)

  contacts   Contact[]
  prospects  Prospect[]
  equipments Equipment[]
  attentions Attention[]

  @@index([companyId, name])
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  roleTitle String?
  email     String?
  isPrimary Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prospect {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  ownerUserId String?
  source      String?
  note        String?
  status      String   @default("NUEVO")
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  activities ProspectActivity[]

  @@index([companyId, status])
}

model ProspectActivity {
  id           String    @id @default(cuid())
  prospectId   String
  prospect     Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  note         String
  nextFollowUp DateTime?
  authorUserId String
  createdAt    DateTime  @default(now())
}

model Supplier {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  contactName   String?
  phone         String?
  email         String?
  rfc           String?
  fiscalAddress String?
  creditDays    Int?
  issuesInvoice Boolean?
  category      String?
  active        Boolean  @default(true)
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  version       Int      @default(1)

  @@index([companyId, name])
}

/// companyId "GLOBAL" is the shared MOT sequence. Every other series is per company.
model FolioSequence {
  id         String @id @default(cuid())
  companyId  String
  series     String
  nextNumber Int    @default(1)

  @@unique([companyId, series])
}

model IntegrationSetting {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  provider   String
  secretEnc  String?
  secretHint String?
  updatedAt  DateTime @updatedAt

  @@unique([companyId, provider])
}

model EquipmentType {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, name])
}

model EquipmentBrand {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, name])
}

/// EQUI belongs to one company. MOT is a global physical identity with originCompanyId.
model Equipment {
  id              String   @id @default(cuid())
  kind            String
  folio           String   @unique
  originCompanyId String
  originCompany   Company  @relation("EquipmentOrigin", fields: [originCompanyId], references: [id])
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  typeName        String?
  brandName       String?
  model           String
  description     String?
  serial          String?
  custody         String
  holderCompanyId String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  attentions     Attention[]
  movements      CustodyMovement[]
  technicalCases TechnicalCase[]

  @@index([originCompanyId, kind])
  @@index([custody])
}

model Priority {
  id              String  @id @default(cuid())
  companyId       String
  company         Company @relation(fields: [companyId], references: [id])
  attentionType   String
  name            String
  price           Float?
  incrementPct    Float?
  targetMinDays   Int?
  targetMaxDays   Int?
  slaMaxDays      Int
  sortOrder       Int     @default(0)
  active          Boolean @default(true)

  @@unique([companyId, attentionType, name])
}

/// Service episode over a physical identity. Diagnosis execution belongs to a later phase.
model Attention {
  id                  String    @id @default(cuid())
  equipmentId         String
  equipment           Equipment @relation(fields: [equipmentId], references: [id])
  originCompanyId     String
  originCompany       Company   @relation("AttentionOrigin", fields: [originCompanyId], references: [id])
  serviceCompanyId    String
  serviceCompany      Company   @relation("AttentionService", fields: [serviceCompanyId], references: [id])
  adminClientId       String
  adminClient         Client    @relation(fields: [adminClientId], references: [id])
  attentionType       String
  priorityName        String
  priorityPrice       Float?
  priorityIncrementPct Float?
  priorityTargetMin   Int?
  priorityTargetMax   Int?
  prioritySlaMaxDays  Int
  reportedFault       String
  antecedent          String?
  deliveryInstructions String?
  sellerUserId        String?
  originalCaseId      String?
  status              String    @default("ABIERTA")
  slaStartedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  version             Int       @default(1)

  movements      CustodyMovement[]
  technicalCases TechnicalCase[]

  @@index([equipmentId])
  @@index([serviceCompanyId, status])
}

model TechnicalCase {
  id                  String    @id @default(cuid())
  folio               String    @unique
  attentionId         String
  attention           Attention @relation(fields: [attentionId], references: [id])
  equipmentId         String
  equipment           Equipment @relation(fields: [equipmentId], references: [id])
  serviceCompanyId    String
  serviceCompany      Company   @relation(fields: [serviceCompanyId], references: [id])
  kind                String
  status              String
  assigneeUserId      String?
  assignee            User?     @relation(fields: [assigneeUserId], references: [id])
  externalSupplierId  String?
  externalDocument    String?
  resultText          String?
  warrantyDecision    String?
  commercialDecision  String?
  commercialReason    String?
  originalCaseId      String?
  spawnedFromId       String?
  paidAt              DateTime?
  quotePending        Boolean   @default(false)
  returnReason        String?
  slaDueAt            DateTime?
  finishedByUserId    String?
  validatedByUserId   String?
  validatedAt         DateTime?
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  logs     TechnicalLog[]
  requests PartRequest[]

  @@index([serviceCompanyId, status])
  @@index([equipmentId])
  @@index([attentionId])
}

model TechnicalLog {
  id           String        @id @default(cuid())
  caseId       String
  case         TechnicalCase @relation(fields: [caseId], references: [id])
  body         String
  authorUserId String
  createdAt    DateTime      @default(now())

  @@index([caseId, createdAt])
}

model PartRequest {
  id           String        @id @default(cuid())
  caseId       String
  case         TechnicalCase @relation(fields: [caseId], references: [id])
  companyId    String
  partNumber   String
  description  String
  link         String?
  qtyRequested Int
  qtyReceived  Int           @default(0)
  qtyIssued    Int           @default(0)
  status       String        @default("SOLICITADA")
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([caseId])
}

model CustodyMovement {
  id               String    @id @default(cuid())
  equipmentId      String
  equipment        Equipment @relation(fields: [equipmentId], references: [id])
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  attentionId      String?
  attention        Attention? @relation(fields: [attentionId], references: [id])
  kind             String
  reason           String
  receiverName     String?
  deliveryMode     String?
  contact          String?
  enablingDocument String?
  supplierId       String?
  notes            String?
  authorUserId     String
  occurredAt       DateTime  @default(now())
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime  @default(now())

  @@index([equipmentId, createdAt])
  @@index([companyId, kind])
}

model Part {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  partNumber  String
  description String
  qty         Int      @default(0)
  minQty      Int?
  maxQty      Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  movements StockMovement[]

  @@unique([companyId, partNumber])
}

model StockMovement {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  partId       String
  part         Part     @relation(fields: [partId], references: [id])
  kind         String
  quantity     Int
  qtyAfter     Int
  note         String?
  authorUserId String
  createdAt    DateTime @default(now())

  @@index([partId, createdAt])
}

model FunctionalHistory {
  id           String   @id @default(cuid())
  companyId    String?
  entityType   String
  entityId     String
  action       String
  summary      String
  authorUserId String?
  author       User?    @relation(fields: [authorUserId], references: [id])
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}
